# ─────────────────────────────────────────────────────────────────────────
# Backend (Python / FastAPI)
# ─────────────────────────────────────────────────────────────────────────
backend/venv/
backend/.venv/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local storage used by STORAGE_PROVIDER=local (uploaded KB docs, etc.)
backend/storage/

# Env file — contains local DB creds. Keep an .env.example in git instead.
backend/.env

# ─────────────────────────────────────────────────────────────────────────
# Frontend (Node / Vite / TypeScript)
# ─────────────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.tsbuildinfo
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─────────────────────────────────────────────────────────────────────────
# Editor / OS noise
# ─────────────────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ─────────────────────────────────────────────────────────────────────────
# Misc
# ─────────────────────────────────────────────────────────────────────────
*.log
.env.local
.env.*.local
